select count(*) AS CityCount
From city
where POPULATION > 100000;
[Selecting a total number]
select SUM(POPULATION) as totalPopulation
From City
where District = 'California';
[Selecting Averagew population]
select AVG(population) AS averagePopulation
from city
where district = 'California';
[Rounding off avrage value with the floor()]
[Selecting Averagew population]
select floor(AVG(population)) as AveragePopulation
from City;
